    "check:database": "node scripts/check-database.mjs",
    "db:start": "npx supabase start",
    "db:reset": "npx supabase db reset",
    "db:status": "npx supabase status",
    "check:onboarding": "node scripts/check-onboarding.mjs",
    "check:auth": "node scripts/check-auth.mjs",
    "check:preview": "node scripts/check-preview.mjs",
    "dev:mailbox": "node scripts/dev-mailbox.mjs",
    "check:password-recovery": "node scripts/check-password-recovery.mjs",
    "check:businesses": "node scripts/check-businesses.mjs",
    "check:interactions": "node scripts/check-interactions.mjs",
    "check:overview": "node scripts/check-overview.mjs",
    "check:agenda": "node scripts/check-agenda.mjs",
    "check:security": "node scripts/check-security.mjs",
    "check:agenda-regressions": "node scripts/check-agenda-regressions.mjs",
    "check:production-core": "node scripts/check-production-core.mjs",
    "check:theme-integrity": "node scripts/check-theme-integrity.mjs",
    "check:finance": "node scripts/check-finance-v116.mjs",
    "check:launch-readiness": "node scripts/check-launch-readiness.mjs",
    "check:manual-pix": "node scripts/check-manual-pix.mjs",
    "check:mobile-readiness": "node scripts/check-mobile-readiness-v1163.mjs",
    "check:platform-admin": "node scripts/check-platform-admin.mjs",
    "admin:grant": "node scripts/grant-platform-admin.mjs",
    "check:launch-zero-config": "node scripts/check-launch-zero-config.mjs",
    "preflight:production": "node scripts/preflight-production.mjs",
