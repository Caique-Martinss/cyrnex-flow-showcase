# CYRNEX FLOW â€” public environment example
# Copy to .env locally and fill values only on your own machine/hosting.

# Backend
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Frontend
VITE_API_URL=/api

# Authentication
CYRNEX_AUTH_PROVIDER=local

# Supabase â€” keep secret key backend-only
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Password recovery
PASSWORD_RECOVERY_DELIVERY=development
PASSWORD_RECOVERY_CODE_MINUTES=10
PASSWORD_RECOVERY_RESEND_SECONDS=60
PASSWORD_RECOVERY_EXPOSE_CODE=false

# SMTP â€” only required for real email delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=CYRNEX FLOW <no-reply@example.com>

# Platform admin bootstrap â€” optional local/manual values
CYRNEX_ADMIN_USERNAME=
CYRNEX_ADMIN_EMAIL=
CYRNEX_ADMIN_DISPLAY_NAME=
CYRNEX_ADMIN_ROLE=super_admin

# Observability
CYRNEX_SLOW_REQUEST_MS=1800
CYRNEX_EXTERNAL_STATUS_URL=

